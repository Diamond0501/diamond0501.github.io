---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: { title: string; description: string; noindex?: boolean };
}

const { title, description, noindex } = Astro.props.frontmatter;
---

<BaseLayout locale="de" {title} {description} {noindex}>
  <div class="wrap legal">
    <div class="prose max-w-3xl">
      <h1>{title}</h1>
      <slot />
    </div>
  </div>
</BaseLayout>
