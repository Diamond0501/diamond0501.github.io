---
import { contact } from '../../data/pages/contact';
import type { Locale } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactSections from '../ContactSections.astro';
import PageHead from '../PageHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = contact[locale];
---

<BaseLayout {locale} pageKey="contact" title={t.title} description={t.description}>
  <PageHead {...t.head} />
  <ContactSections {locale} />
</BaseLayout>
