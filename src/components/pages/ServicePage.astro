---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import { service, type ServiceContent } from '../../data/pages/service';
import { site, type Locale } from '../../data/site';
import type { PageKey } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Closing from '../Closing.astro';
import IconList from '../IconList.astro';
import PageHead from '../PageHead.astro';
import RecList from '../RecList.astro';
import SectionHead from '../SectionHead.astro';
import SplitSection from '../SplitSection.astro';
import TopicGrid from '../TopicGrid.astro';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  content: ServiceContent;
  photo: ImageMetadata;
}

const { locale, pageKey, content: t, photo } = Astro.props;
const shared = service[locale];
const euros = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
---

<BaseLayout {locale} {pageKey} title={t.title} description={t.description}>
  <PageHead {...t.head}>
    <figure class="photo">
      <Picture
        src={photo}
        formats={['avif', 'webp']}
        widths={[600, 900, 1200]}
        sizes="(max-width: 860px) 100vw, 34rem"
        alt=""
        loading="eager"
      />
    </figure>
  </PageHead>

  <SplitSection title={shared.approach.title} tinted>
    <IconList items={t.approach.items} />
  </SplitSection>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={shared.topics.eyebrow} title={t.topics.title} />
      <TopicGrid items={t.topics.items} />
    </div>
  </section>

  <section class="tint" id="ablauf">
    <div class="wrap">
      <SectionHead eyebrow={shared.process.eyebrow} title={shared.process.title} />
      <TopicGrid items={[shared.process.intro, ...t.process.items]} four />
      <p class="note">
        <Icon name="ph:info-duotone" aria-hidden="true" is:inline />
        {shared.process.note}
      </p>
    </div>
  </section>

  <SplitSection eyebrow={shared.online.eyebrow} title={shared.online.title}>
    <RecList items={shared.online.items} />
  </SplitSection>

  <SplitSection id="kosten" eyebrow={shared.fees.eyebrow} title={shared.fees.title} tinted>
    <div class="price-grid">
      {t.prices.map((card) => (
        <article class="card price-card">
          <h3>{card.title}</h3>
          <dl>
            {card.rates.map((rate) => (
              <div>
                <dt>
                  {rate.minutes} {shared.fees.minutes}
                </dt>
                <dd>{euros.format(rate.euros)}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
    <RecList items={shared.fees.conditions} />
    <div class="more-links">
      <a class="more" href="/agb/" hreflang={site.locales.de}>
        {shared.fees.termsLink}
      </a>
    </div>
    <p class="note">
      <Icon name="ph:info-duotone" aria-hidden="true" is:inline />
      {shared.fees.note}
    </p>
  </SplitSection>

  <Closing {locale} />
</BaseLayout>
