---
import { Picture } from 'astro:assets';
import coachingPhoto from '../../assets/photos/coaching-path.jpg';
import couplesPhoto from '../../assets/photos/paartherapie-field.jpg';
import { home } from '../../data/pages/home';
import type { Locale } from '../../data/site';
import { pathFor } from '../../i18n/routes';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Closing from '../Closing.astro';
import Hero from '../Hero.astro';
import RecList from '../RecList.astro';
import SectionHead from '../SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = home[locale];
const offers = [
  { ...t.offers.couples, photo: couplesPhoto, href: pathFor('couples', locale) },
  { ...t.offers.coaching, photo: coachingPhoto, href: pathFor('coaching', locale) },
];
---

<BaseLayout {locale} pageKey="home" title={t.title} description={t.description}>
  <Hero {locale} content={t.hero} />

  <section class="tint">
    <div class="wrap">
      <SectionHead title={t.offers.title} />
      <div class="offer-grid">
        {offers.map((offer) => (
          <article class="offer card">
            <figure class="photo">
              <Picture
                src={offer.photo}
                formats={['avif', 'webp']}
                widths={[600, 900, 1200]}
                sizes="(max-width: 860px) 100vw, 40rem"
                alt=""
              />
            </figure>
            <div class="offer-body">
              <h3>{offer.title}</h3>
              <p>{offer.text}</p>
              <RecList items={offer.signs} />
              <a class="more" href={offer.href}>
                {offer.link}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Closing {locale} />
</BaseLayout>
