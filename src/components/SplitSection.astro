---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  tinted?: boolean;
  id?: string;
}

const { title, eyebrow, lead, tinted = false, id } = Astro.props;
---

<section class={tinted ? 'tint' : 'section'} {id}>
  <div class="wrap two-col">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <div>
      <slot />
    </div>
  </div>
</section>
