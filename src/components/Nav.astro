---
import { Icon } from 'astro-icon/components';
import { site, type Locale } from '../data/site';
import { navKeys, pathFor, type PageKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  pageKey?: PageKey;
}

const { locale, pageKey } = Astro.props;
const t = ui[locale];
const pageLinks = navKeys.map((key) => ({
  href: pathFor(key, locale),
  label: t.nav[key],
  current: key === pageKey ? ('page' as const) : undefined,
}));
---

<header class="topbar">
  <nav class="nav wrap" aria-label={t.mainNavLabel}>
    <a class="wordmark" href={pathFor('home', locale)}>
      {site.name}
    </a>
    <ul class="links">
      {pageLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={link.current}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <LanguageSwitcher {locale} {pageKey} />
    <a class="nav-cta" href={pathFor('contact', locale)} aria-current={pageKey === 'contact' ? 'page' : undefined}>
      {t.nav.contact}
    </a>
    <details class="menu">
      <summary>
        <Icon name="ph:list" aria-hidden="true" />
        <span class="sr-only">{t.menuLabel}</span>
      </summary>
      <div class="menu-panel">
        <div class="wrap">
          <ul>
            {pageLinks.map((link) => (
              <li>
                <a href={link.href} aria-current={link.current}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <LanguageSwitcher {locale} {pageKey} />
        </div>
      </div>
    </details>
  </nav>
</header>
