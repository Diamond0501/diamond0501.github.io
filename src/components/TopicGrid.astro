---
import IconTile from './IconTile.astro';

interface Props {
  items: { icon: string; title: string; text: string }[];
}

const { items } = Astro.props;
---

<ul class="topic-grid">
  {items.map((item) => (
    <li class="topic card">
      <IconTile icon={item.icon} />
      <h3>{item.title}</h3>
      <p>{item.text}</p>
    </li>
  ))}
</ul>
