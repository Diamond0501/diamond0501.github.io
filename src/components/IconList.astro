---
import IconTile from './IconTile.astro';

interface Props {
  items: { icon: string; title: string; text: string }[];
  ordered?: boolean;
}

const { items, ordered = false } = Astro.props;
const List = ordered ? 'ol' : 'ul';
---

<List class="icon-list card">
  {items.map((item) => (
    <li>
      <IconTile icon={item.icon} />
      <div>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
      </div>
    </li>
  ))}
</List>
