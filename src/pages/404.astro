---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { pathFor } from '../i18n/routes';
---

<BaseLayout locale="de" title="Seite nicht gefunden" description="Diese Seite gibt es nicht." noindex>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">404</p>
        <h1>Seite nicht gefunden</h1>
        <p>Diese Seite gibt es leider nicht (mehr).</p>
      </div>
      <div class="more-links">
        <a class="more" href={pathFor('home', 'de')}>
          Zur Startseite
        </a>
        <a class="more" href={pathFor('home', 'en')} lang={site.locales.en} hreflang={site.locales.en}>
          Go to the home page
        </a>
        <a class="more" href={pathFor('home', 'zh')} lang={site.locales.zh} hreflang={site.locales.zh}>
          返回首页
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
